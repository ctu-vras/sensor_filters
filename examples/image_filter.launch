SPDX-FileCopyrightText: Czech Technical University in Prague

An example launch file for running a filter on Image messages. This example showcases that the filter chain uses
image_transport to subscribe and publish.
-->

<launch>
    <arg name="publish_sample_data" default="false" />

    <node pkg="sensor_filters" exec="image_filter_chain" output="screen" name="image_filter">
        <remap from="input" to="image" />
        <remap from="output" to="image_filtered" />
        <param from="$(dirname)/image_filter.yaml" />
    </node>

    <group if="$(var publish_sample_data)">
        <executable name="pub" cmd="ros2 topic pub /image_raw sensor_msgs/Image '{
            header: {stamp: {sec: 10, nanosec: 0}, frame_id: &quot;camera&quot;},
            height: 1,
            width: 1,
            encoding: &quot;mono8&quot;,
            is_bigendian: false,
            step: 1,
            data: [0],
            }'"/>
        <node name="encode" pkg="image_transport" exec="republish">
            <param name="in_transport" value="raw" />
            <param name="out_transport" value="compressed" />
            <remap from="in" to="/image_raw" />
            <remap from="out/compressed" to="/image/compressed" />
        </node>
    </group>
</launch>
